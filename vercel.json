{
 "buildCommand": "npm install && npx expo export --platform web --quiet",
 "outputDirectory": "dist",
 "rewrites": [
  {
   "source": "/(.*)",
   "destination": "/index.html"
  }
 ],
 "headers": [
  {
   "source": "/_expo/static/js/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ]
}
