{
  "buildCommand": "npx expo export:web",
  "outputDirectory": "web",
  "devCommand": "npx expo start",
  "installCommand": "npm install",
  "framework": "expo",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
